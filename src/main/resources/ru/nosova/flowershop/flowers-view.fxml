<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.nosova.flowershop.controller.FlowersController">
   <top>
      <ToolBar BorderPane.alignment="CENTER">
         <items>
            <Label text="%label.label" />
            <ComboBox fx:id="boxMenu" onAction="#onMenu" prefWidth="150.0" promptText="%combobox.box_menu" />
            <Button fx:id="buttonBack" mnemonicParsing="false" onAction="#onBack" text="%button.button_back" />
         </items>
      </ToolBar>
   </top>
   <bottom>
      <HBox maxWidth="-Infinity" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="buttonDelivery" mnemonicParsing="false" onAction="#onDelivery" text="%button.button_delivery">
               <HBox.margin>
                  <Insets right="5.0" top="5.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="buttonReset" mnemonicParsing="false" onAction="#onReset" text="%button.button_reset">
               <HBox.margin>
                  <Insets bottom="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="buttonDelete" mnemonicParsing="false" onAction="#onDelete" text="%button.button_delete">
               <HBox.margin>
                  <Insets bottom="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="buttonExit" mnemonicParsing="false" onAction="#onExit" text="%button.button_exit">
               <HBox.margin>
                  <Insets bottom="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </bottom>
   <left>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <Label text="%label.findFlowersBy">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="findFlowefsName" promptText="%textfield.find_flowefs_name">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" />
               </VBox.margin>
            </TextField>
            <TextField fx:id="findPriceMin" promptText="%textfield.find_price_min">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" />
               </VBox.margin>
            </TextField>
            <TextField fx:id="findPriceMax" layoutX="15.0" layoutY="62.0" promptText="%textfield.find_price_max">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" />
               </VBox.margin>
            </TextField>
            <Button fx:id="buttonFind" mnemonicParsing="false" onAction="#onFind" text="%button.buttonFindFlowers">
               <VBox.margin>
                  <Insets left="5.0" />
               </VBox.margin>
            </Button>
            <Label fx:id="idErrorFind" />
            <Label layoutX="15.0" layoutY="10.0" text="%label.editFlowers">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" top="5.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="editFnlowefsName" layoutX="15.0" layoutY="32.0" promptText="%textfield.edit_fnlowefs_name">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" />
               </VBox.margin>
            </TextField>
            <Button fx:id="buttonChoosePhoto" mnemonicParsing="false" onAction="#onChooseEditPhoto" text="%button.button_choose_photo">
               <VBox.margin>
                  <Insets left="5.0" />
               </VBox.margin>
            </Button>
            <ImageView fx:id="editImg" fitHeight="100.0" fitWidth="100.0" nodeOrientation="RIGHT_TO_LEFT" pickOnBounds="true" preserveRatio="true">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" />
               </VBox.margin>
            </ImageView>
            <Label fx:id="idErrorEdit" />
            <Button fx:id="buttonEdit" mnemonicParsing="false" onAction="#onEdit" text="%button.buttonEditFlowers">
               <VBox.margin>
                  <Insets left="5.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </left>
   <center>
      <ScrollPane maxHeight="400.0" minHeight="200.0" BorderPane.alignment="CENTER">
         <content>
            <FlowPane fx:id="idFlowPane" />
         </content>
      </ScrollPane>
   </center>
   <right>
      <VBox maxHeight="280.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="%label.addFlowers">
               <VBox.margin>
                  <Insets left="5.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="addFnlowefsName" promptText="%textfield.add_fnlowefs_name">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
            </TextField>
            <TextField fx:id="addPrice" promptText="%textfield.add_price">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" />
               </VBox.margin>
            </TextField>
            <TextField fx:id="addCount" promptText="%textfield.add_count">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" />
               </VBox.margin>
            </TextField>
            <Button mnemonicParsing="false" onAction="#onChooseAddPhoto" text="%button.button_choose_photo">
               <VBox.margin>
                  <Insets left="5.0" />
               </VBox.margin>
            </Button>
            <ImageView fx:id="addImg" fitHeight="100.0" fitWidth="100.0" nodeOrientation="RIGHT_TO_LEFT" pickOnBounds="true" preserveRatio="true">
               <VBox.margin>
                  <Insets left="5.0" />
               </VBox.margin>
            </ImageView>
            <Label fx:id="idErrorAdd" />
            <Button fx:id="buttonAdd" mnemonicParsing="false" onAction="#onAdd" text="%button.buttonAddFlowers" />
         </children></VBox>
   </right>
</BorderPane>
