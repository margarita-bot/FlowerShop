<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.nosova.flowershop.controller.BouquetCreateController">
   <children>
      <VBox>
         <children>
            <Label text="%label.addNameBouquet" />
            <TextField fx:id="addNameBouquet" maxWidth="200.0" promptText="%textfield.add_name_bouquet" />
            <HBox>
               <children>
                  <Label text="%label.addPriceBouquet" />
                  <Label fx:id="addPrice">
                     <HBox.margin>
                        <Insets left="5.0" />
                     </HBox.margin>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </HBox>
            <Label text="%label.addTextBouquet" />
            <TextArea fx:id="addText" maxHeight="200.0" maxWidth="200.0" promptText="%textarea.add_text" />
            <Label fx:id="idError" layoutX="20.0" layoutY="70.0" />
            <HBox>
               <children>
                  <Button fx:id="buttonBouquetComposition" mnemonicParsing="false" onAction="#onBouquetComposition" text="%button.button_bouquet_composition">
                     <HBox.margin>
                        <Insets right="5.0" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="buttonCreate" mnemonicParsing="false" onAction="#onCreate" text="%button.button_create">
                     <HBox.margin>
                        <Insets right="5.0" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="buttonCancel" mnemonicParsing="false" onAction="#onCancel" text="%button.button_cancel" />
               </children>
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </HBox>
         </children>
         <padding>
            <Insets left="10.0" />
         </padding>
      </VBox>
   </children>
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
</Pane>
