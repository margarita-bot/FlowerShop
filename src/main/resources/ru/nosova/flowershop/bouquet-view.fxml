<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.nosova.flowershop.controller.BouquetController">
   <top>
      <ToolBar BorderPane.alignment="CENTER">
         <items>
            <Label text="%label.label" />
            <ComboBox fx:id="boxMenu" onAction="#onMenu" prefWidth="150.0" promptText="%combobox.box_menu" />
            <Button fx:id="buttonBack" mnemonicParsing="false" onAction="#onBack" text="%button.button_back" />
         </items>
      </ToolBar>
   </top>
   <center>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <TableView fx:id="TableBouguet" minWidth="400.0" tableMenuButtonVisible="true">
               <columns>
                  <TableColumn fx:id="columnName" prefWidth="75.0" text="%tablecolumn.column_name_bouquet" />
                  <TableColumn fx:id="columnPrice" prefWidth="75.0" text="%tablecolumn.column_price" />
                  <TableColumn fx:id="columnText" prefWidth="75.0" text="%tablecolumn.column_text" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
   <left>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <Label text="%label.findBouquet">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" />
               </VBox.margin></Label>
            <TextField fx:id="findName" promptText="%textfield.find_name">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" />
               </VBox.margin></TextField>
            <TextField fx:id="findPrice" promptText="%textfield.find_minprice">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" />
               </VBox.margin></TextField>
            <TextField fx:id="findPriceMax" layoutX="15.0" layoutY="60.0" promptText="%textfield.find_maxprice">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" />
               </VBox.margin>
            </TextField>
            <Button fx:id="buttonFind" mnemonicParsing="false" onAction="#onFind" text="%button.button_find_bouquet">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" />
               </VBox.margin></Button>
            <Label fx:id="idErrorFind" layoutX="10.0" layoutY="162.0" />
            <Button fx:id="buttonEdit" mnemonicParsing="false" onAction="#onEdit" text="%button.button_edit_bouquet">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" />
               </VBox.margin></Button>
         </children>
      </VBox>
   </left>
   <right>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <Label text="%label.moreBoucuer" />
            <VBox>
               <children>
                  <Label text="%label.ditailsBouquet">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <HBox>
                     <children>
                        <Label text="%label.nameBouquet">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                           <HBox.margin>
                              <Insets right="5.0" />
                           </HBox.margin>
                        </Label>
                        <Label fx:id="idNameBouquet" />
                     </children>
                     <VBox.margin>
                        <Insets right="5.0" />
                     </VBox.margin>
                  </HBox>
                  <HBox layoutX="10.0" layoutY="27.0">
                     <children>
                        <Label text="%label.priceBouquet">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                           <HBox.margin>
                              <Insets right="5.0" />
                           </HBox.margin>
                        </Label>
                        <Label fx:id="idPriceBouquet" />
                     </children>
                  </HBox>
                  <Label text="%label.text">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TextArea fx:id="idBouquetText" maxWidth="200.0" wrapText="true">
                     <padding>
                        <Insets right="5.0" />
                     </padding>
                  </TextArea>
               </children>
            </VBox>
         </children>
      </VBox>
   </right>
   <bottom>
      <HBox BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="buttonAdd" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#onAdd" text="%button.button_add_bouquet">
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="buttonReset" mnemonicParsing="false" onAction="#onReset" text="%button.button_reset">
               <HBox.margin>
                  <Insets bottom="5.0" right="5.0" top="5.0" />
               </HBox.margin></Button>
            <Button fx:id="buttonDelete" mnemonicParsing="false" onAction="#onDelete" text="%button.button_delete">
               <HBox.margin>
                  <Insets bottom="5.0" right="5.0" top="5.0" />
               </HBox.margin></Button>
            <Button fx:id="buttonExit" mnemonicParsing="false" onAction="#onExit" text="%button.button_exit">
               <HBox.margin>
                  <Insets bottom="5.0" right="5.0" top="5.0" />
               </HBox.margin></Button>
         </children>
      </HBox>
   </bottom>
</BorderPane>
