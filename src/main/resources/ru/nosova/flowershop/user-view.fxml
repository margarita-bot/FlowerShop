<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="250.0" prefWidth="300.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.nosova.flowershop.controller.UserController">
   <children>
      <VBox prefHeight="85.0" prefWidth="150.0" AnchorPane.leftAnchor="70.0" AnchorPane.topAnchor="75.0">
         <children>
            <Label text="%label.label" />
            <TextField fx:id="login" />
            <Label text="%label.label_2" />
            <TextField fx:id="pass" />
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button defaultButton="true" mnemonicParsing="false" onAction="#onOk" text="%button.button" />
                  <Button mnemonicParsing="false" onAction="#onClose" text="%button.button_2" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
